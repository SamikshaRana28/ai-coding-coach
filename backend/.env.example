# Copy to backend/.env for local development. NEVER commit the real .env.
# On Render, set these in the service's Environment tab instead.

# ── Database ────────────────────────────────────────────────────────────────
# Local (docker-compose / default if unset):
#   postgresql://postgres:password@localhost/coding_coach
# Neon (use the connection string from the Neon dashboard; sslmode=require is
# added automatically for remote hosts if you leave it out):
#   postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost/coding_coach

# ── LLM ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED, >= 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Token lifetime in days (default 7)
JWT_EXPIRE_DAYS=7

# Comma-separated list of allowed frontend origins. Empty = "*" (allow all).
# Production example: https://your-app.vercel.app
CORS_ORIGINS=

# Rate limit for /auth/login and /auth/signup (per client IP)
AUTH_RATE_LIMIT=10/minute
# Set to false to disable rate limiting (tests/local debugging only)
RATE_LIMIT_ENABLED=true
# Number of reverse proxies in front of the app (Render = start with 1).
# 0 ignores X-Forwarded-For (then every user behind a proxy shares one limit bucket).
TRUSTED_PROXY_HOPS=0

# ── Optional DB pool tuning ────────────────────────────────────────────────
# DB_POOL_RECYCLE_SECONDS=300
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

# ── Demo user seeding (only read by `python seed_demo_user.py`) ─────────────
DEMO_EMAIL=demo@example.com
DEMO_NAME=Demo User
DEMO_PASSWORD=
