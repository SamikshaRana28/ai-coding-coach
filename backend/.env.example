# ── Core ────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
DATABASE_URL=

# ── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED, >= 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Token lifetime in days (default 7)
JWT_EXPIRE_DAYS=7

# ── Part 6: scheduled nudges + optional reminder emails ─────────────────────
# Secret for POST /internal/cron/daily-nudges (header X-Cron-Secret). Endpoint is DISABLED
# (503) until this is set. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=
# Emails are optional. Leave all empty and the app still creates in-app notifications.
# Option 1: Resend (https://resend.com)
# EMAIL_FROM=
RESEND_API_KEY=
# Option 2: any SMTP server (instead of Resend)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=

# ── Optional DB pool tuning ────────────────────────────────────────────────
# DB_POOL_RECYCLE_SECONDS=300
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
